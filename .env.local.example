# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored by Next.js's default setup — never commit
# real secrets. NEXT_PUBLIC_ vars are exposed to the browser (required for
# Firebase's client SDK); anything without that prefix stays server-only.

# --- Firebase (get these from Firebase Console → Project Settings) ---------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maitrimoon-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maitrimoon-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maitrimoon-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- MaitryMoon backend API --------------------------------------------------
# Production: https://api.maitrimoon.com
# Staging/dev: http://155.248.243.31
NEXT_PUBLIC_API_BASE_URL=https://api.maitrimoon.com

# --- Instagram feed (already used by the homepage) --------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
